<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generatore Etichetta UPS v3 Final</title>
    
    <script src="https://cdn.jsdelivr.net/npm/bwip-js@3.2.1/dist/bwip-js-min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        /* Reset e font di base simili a quelli UPS */
        * { box-sizing: border-box; }
        body {
            font-family: "Arial Narrow", Arial, Helvetica, sans-serif;
            background-color: #d0d0d0;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        /* --- PANNELLO DI CONTROLLO --- */
        .controls {
            background: white; padding: 20px; border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2); text-align: center; margin-bottom: 30px;
        }
        .controls input {
            padding: 12px; font-size: 18px; width: 300px; text-transform: uppercase;
            border: 2px solid #333; border-radius: 4px; font-family: monospace;
        }
        .action-buttons { margin-top: 15px; display: flex; gap: 10px; justify-content: center; }
        .btn {
            padding: 12px 24px; font-size: 16px; cursor: pointer; border: none;
            border-radius: 4px; font-weight: bold; transition: background-color 0.2s;
        }
        .btn-gen { background-color: #333; color: #fff; }
        .btn-gen:hover { background-color: #000; }
        .btn-down { background-color: #ffb500; color: #000; }
        .btn-down:hover { background-color: #e5a300; }

        /* --- STRUTTURA ETICHETTA RIGIDA --- */
        .label-wrapper {
            background-color: white;
            padding: 20px; /* Spazio bianco attorno per il ritaglio */
        }

        .ups-label {
            width: 400px;  /* Larghezza fissa */
            height: 640px; /* Altezza fissa per proporzione 4x6 */
            background-color: white;
            border: 3px solid black; /* Bordo esterno spesso */
            display: flex;
            flex-direction: column;
            color: #000;
            overflow: hidden; /* Impedisce a qualsiasi cosa di uscire */
            position: relative;
        }

        /* Sezioni interne con bordi spessi */
        .section-header { height: 30px; border-bottom: 3px solid black; display: flex; justify-content: flex-end; align-items: center; padding-right: 10px; font-weight: bold; font-size: 12px; }
        
        .section-ship-to { 
            height: 130px; border-bottom: 3px solid black; padding: 10px 15px; 
            display: flex; flex-direction: column; justify-content: center;
        }
        .ship-title { font-size: 14px; font-weight: bold; margin-bottom: 5px; }
        .ship-address { font-size: 18px; font-weight: bold; line-height: 1.3; margin-left: 20px; text-transform: uppercase; }
        .ship-zip { font-size: 22px; display: block; margin-top: 5px; }

        /* Sezione centrale complessa */
        .section-routing {
            height: 120px; border-bottom: 6px solid black; /* Bordo molto spesso sotto */
            display: flex;
            overflow: hidden; /* CRUCIALE: impedisce i pallini neri sul testo */
        }
        .maxicode-container {
            width: 120px; /* Larghezza fissa per il quadrato */
            height: 100%;
            border-right: 3px solid black;
            padding: 10px;
            display: flex; justify-content: center; align-items: center;
            overflow: hidden;
        }
        .routing-text-container {
            flex-grow: 1;
            display: flex; justify-content: center; align-items: center;
            font-size: 42px; font-weight: 900; letter-spacing: -1px;
            overflow: hidden; white-space: nowrap; /* Impedisce al testo di andare a capo o sbordare */
        }

        /* Barra servizio nera */
        .section-service {
            height: 40px; background-color: black; color: white;
            display: flex; align-items: center; padding-left: 15px;
            font-size: 32px; font-weight: bold; text-transform: uppercase;
        }

        .section-tracking-num {
            height: 30px; border-bottom: 3px solid black;
            display: flex; align-items: center; padding-left: 15px; font-weight: bold;
        }
        .track-label { font-size: 12px; margin-right: 5px; }
        .track-value { font-size: 16px; }

        /* Sezione Barcode inferiore */
        .section-barcode-main {
            flex-grow: 1; /* Occupa tutto lo spazio rimanente */
            border-bottom: 6px solid black;
            padding: 10px 0;
            display: flex; justify-content: center; align-items: center;
            overflow: hidden; /* CRUCIALE: taglia il barcode se troppo grande */
        }

        .section-footer {
            height: 50px; padding: 5px 15px;
            display: flex; justify-content: space-between; align-items: flex-end;
            font-weight: bold; font-size: 12px;
        }
        .footer-edi { font-size: 36px; line-height: 1; }

        /* --- GESTIONE CANVAS --- */
        /* Forza i canvas a non superare mai i loro contenitori */
        canvas.bc-canvas {
            display: block;
            max-width: 100% !important;
            max-height: 100% !important;
            object-fit: contain;
        }
    </style>
</head>
<body>

    <div class="controls">
        <label style="font-weight:bold; display:block; margin-bottom:10px;">INSERISCI TRACKING UPS:</label>
        <input type="text" id="trackingInput" value="1ZHJJKB0PHHI0B8JNV" onfocus="this.select()">
        <div class="action-buttons">
            <button class="btn btn-gen" onclick="updateLabel()">Aggiorna Etichetta</button>
            <button class="btn btn-down" onclick="downloadJPG()">Scarica JPG</button>
        </div>
    </div>

    <div class="label-wrapper">
        <div class="ups-label" id="printableArea">
            <div class="section-header">
               1 KG &nbsp;&nbsp;|&nbsp;&nbsp; 1 OF 1
            </div>

            <div class="section-ship-to">
                <div class="ship-title">SHIP TO:</div>
                <div class="ship-address">
                    I LOVE SHOPPING<br>
                    VIA TARDIO SNC<br>
                    <span class="ship-zip">71016 SAN SEVERO IT</span>
                </div>
            </div>

            <div class="section-routing">
                <div class="maxicode-container">
                    <canvas id="canvas-maxi" class="bc-canvas"></canvas>
                </div>
                <div class="routing-text-container">
                    ITA 297 6-01
                </div>
            </div>

            <div class="section-service">
                UPS STANDARD
            </div>

            <div class="section-tracking-num">
                <span class="track-label">TRACKING #:</span>
                <span class="track-value" id="txt-tracking">1Z ...</span>
            </div>

            <div class="section-barcode-main">
                 <canvas id="canvas-barcode-main" class="bc-canvas"></canvas>
            </div>

            <div class="section-footer">
                <div>BILLING: P/P</div>
                <div class="footer-edi">EDI</div>
            </div>
        </div>
    </div>

    <script>
        function updateLabel() {
            const trackingCode = document.getElementById('trackingInput').value.trim().toUpperCase();
            
            if(!trackingCode) { alert("Inserisci un tracking valido."); return; }
            
            // 1. Aggiorna il testo del tracking
            document.getElementById('txt-tracking').innerText = trackingCode;

            // 2. Pulisce i canvas precedenti per evitare sovrapposizioni
            const canvasMain = document.getElementById('canvas-barcode-main');
            const canvasMaxi = document.getElementById('canvas-maxi');
            canvasMain.getContext('2d').clearRect(0, 0, canvasMain.width, canvasMain.height);
            canvasMaxi.getContext('2d').clearRect(0, 0, canvasMaxi.width, canvasMaxi.height);

            // 3. Genera il BARCODE INFERIORE (Code 128)
            // Usiamo una scala fissa. Il CSS (max-width: 100%) si occuperà di restringerlo se il tracking è lungo.
            try {
                bwipjs.toCanvas('canvas-barcode-main', {
                    bcid:        'code128',       
                    text:        trackingCode,    
                    scale:       3,               // Scala fissa
                    height:      20,              // Altezza relativa delle barre
                    includetext: false,           
                    padding:     5                // Un po' di respiro ai lati
                });
            } catch (e) { console.error("Errore Barcode 1D:", e); }

            // 4. Genera il MAXICODE (2D in alto a sinistra)
            try {
                // Disegniamo un Maxicode standard usando il tracking come dati
                bwipjs.toCanvas('canvas-maxi', {
                    bcid:        'maxicode',
                    text:        trackingCode,
                    scale:       5, // Scala sufficiente per riempire il box 120x120
                    mode:        4, // Mode 4 standard
                    padding:     5
                });
            } catch (e) { console.error("Errore Maxicode:", e); }
        }

        function downloadJPG() {
            // Seleziona l'etichetta
            const element = document.getElementById("printableArea");
            // Usa una scala alta (3) per un'immagine nitida in alta definizione
            html2canvas(element, { scale: 3, backgroundColor: "#ffffff" }).then(canvas => {
                const link = document.createElement('a');
                link.download = 'UPS_' + document.getElementById('trackingInput').value + '.jpg';
                link.href = canvas.toDataURL("image/jpeg", 0.95);
                link.click();
            });
        }

        // Genera al primo avvio
        window.onload = function() {
            document.getElementById('trackingInput').focus();
            updateLabel();
        };
    </script>
</body>
</html>
